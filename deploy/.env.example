# Copy to .env and fill in. Never commit the filled-in file.
# Generate fresh Ed25519 keypairs per environment; see docs/runbooks/key-rotation.md.

LEADS_DB_PASSWORD=change-me-leads
DELIVERY_DB_PASSWORD=change-me-delivery

HANDOFF_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LEAD_ENGINE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
DELIVERY_FACTORY_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
FEEDBACK_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

WORKER_SECRET=change-me-worker
DELIVERY_FACTORY_CRON_SECRET=change-me-cron

# Comma-separated, e.g. https://app.client.com
ALLOWED_ORIGINS=
