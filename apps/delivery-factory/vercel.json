{
  "buildCommand": "pnpm --filter @raphah/handoff-contract build && vite build",
  "cleanUrls": true,
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/workflows/:path*",
      "destination": "/api/wf-dispatch?path=:path*"
    },
    {
      "source": "/api/projects/:path*",
      "destination": "/api/pj-dispatch?path=:path*"
    }
  ]
}