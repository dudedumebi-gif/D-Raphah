# Server-only Neon connection for the Delivery Factory's own database.
# Must never equal the Lead Engine DATABASE_URL — the products do not
# share databases (see docs/adr/0001-delivery-factory-runtime.md).
DELIVERY_DATABASE_URL=

# Lead Engine handoff signing public key (the Lead Engine's
# HANDOFF_SIGNING_PUBLIC_KEY_PEM), distributed out of band — never
# inside the package. Used to Ed25519-verify intake signatures.
LEAD_ENGINE_PUBLIC_KEY_PEM=

# Comma-separated allowlist of origins permitted to call the API.
# No wildcard; empty means same-origin only.
DELIVERY_ALLOWED_ORIGINS=

# Upstash QStash token, required once the Delivery Factory gains its
# own worker/schedules. Signing keys rotate via current/next pair.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Optional server-side error reporting.
SENTRY_DSN=
DELIVERY_ENVIRONMENT=production

# Delivery Factory's own Ed25519 signing key (PEM, single line with \n
# escapes). Signs the delivery-feedback transport envelope; the public key
# is distributed out of band to the Lead Engine as
# DELIVERY_FACTORY_PUBLIC_KEY_PEM. Generate with:
#   node -e "const {generateSigningKeyPair}=require('@raphah/handoff-contract');const k=generateSigningKeyPair();console.log(k.privateKeyPem)"
FEEDBACK_SIGNING_PRIVATE_KEY_PEM=

# Lead Engine base URL the feedback dispatcher POSTs to
# (POST {LEAD_ENGINE_BASE_URL}/api/v1/feedback/events).
LEAD_ENGINE_BASE_URL=

# Shared secret for the internal dispatch endpoint
# (POST /api/internal/dispatch-feedback). Called by the QStash schedule
# with `Authorization: Bearer <secret>`. High-entropy, rotated manually.
DELIVERY_FACTORY_CRON_SECRET=
