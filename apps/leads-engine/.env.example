# Browser-safe Neon Auth + Data API configuration
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# Server-only Neon connection. Use the pooled URL provisioned by Neon.
DATABASE_URL=
NEON_AUTH_URL=
NEON_DATA_API_URL=

# Upstash QStash credentials. QStash signs every scheduler callback.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Ed25519 key pair used to sign LeadEngineHandoffPackage payloads.
HANDOFF_SIGNING_PRIVATE_KEY_PEM=
HANDOFF_SIGNING_PUBLIC_KEY_PEM=

# Delivery Factory intake endpoint that receives dispatched handoffs.
DELIVERY_INTAKE_URL=

# Optional manual/Postman worker invocation. Never expose in VITE_* variables.
WORKER_SECRET=

# Optional server-side error reporting. Vercel structured logs remain enabled without it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Controlled page owned by Raphah for the hourly end-to-end canary.
LEAD_ENGINE_CANARY_URL=
LEAD_ENGINE_CANARY_WORKSPACE_ID=
LEAD_ENGINE_CANARY_SOURCE_ID=

# Public application origin used by OpenAPI links and CORS validation.
LEAD_ENGINE_ORIGIN=https://d-raphah-leads-engine.vercel.app
LEAD_ENGINE_BASE_URL=https://d-raphah-leads-engine.vercel.app
