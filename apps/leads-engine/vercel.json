{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @raphah/handoff-contract build && vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1-dispatch?path=:path*" }
  ]
}
